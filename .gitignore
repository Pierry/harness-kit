# ===========================================
# harness-kit - Git Ignore Rules
# ===========================================

# -------------------------------------------
# Personal context (per-user, not shared)
# -------------------------------------------
context-library/personal-context-*.md
context-library/stakeholder-*.md
context-library/writing-style-*.md

# -------------------------------------------
# Runtime outputs (per-session artifacts)
# -------------------------------------------
.claude/runtime/outputs/pm/prd/
.claude/runtime/outputs/pm/prp/
.claude/runtime/outputs/pm/tokens/
.claude/runtime/outputs/pm/.markers/
.claude/runtime/outputs/sse/plan/
.claude/runtime/outputs/sse/dev/
.claude/runtime/outputs/sse/test/
.claude/runtime/outputs/sse/pr/
.claude/runtime/outputs/sse/sdd/
.claude/runtime/outputs/sse/tokens/
.claude/runtime/outputs/sse/.markers/

# Context cache (repomix packs, graphify graphs)
.claude/runtime/cache/repomix/*
!.claude/runtime/cache/repomix/.gitkeep
.claude/runtime/cache/graphify/*
!.claude/runtime/cache/graphify/.gitkeep

# Pipeline / monitor state
.claude/.pipeline-state.json
.claude/.pr-monitor-state.json
.claude/scheduled_tasks.lock

# Stray runtime state that lands under the cockpit dir when it is run there
tui/.claude/

# -------------------------------------------
# Python bytecode caches
# -------------------------------------------
__pycache__/
*.pyc
*.pyo

# -------------------------------------------
# Claude Code local settings
# -------------------------------------------
.claude/settings.local.json
.claude/.hk-version
.claude/.hk-update-check

# -------------------------------------------
# OS / editor noise
# -------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# -------------------------------------------
# Build / dist
# -------------------------------------------
dist/
node_modules/

# Cockpit bundle is a committed build artifact: plugin/git installs need it
# present (no npm build step runs on those paths). Rebuild with `npm run build:cockpit`.
!tui/dist/
!tui/dist/**
